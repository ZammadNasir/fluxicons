{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "removeComments": false
  },
  "include": [
    "cli/**/*",
    "scripts/**/*",
    "lib/generators/**/*",
    "lib/animation-spec.ts",
    "lib/utils.ts",
    "icons/*/paths.ts",
    "icons/*/animation.spec.ts",
    "icons/*/metadata.ts"
  ],
  "exclude": [
    "node_modules",
    "app/**/*",
    "components/**/*",
    ".next/**/*"
  ]
}